# Minecraft Chinese with Pinyin - Configuration File
#
# Pinyin Annotation Color:
# Sets the Minecraft formatting color code for Pinyin annotations in item names,
# menus, and mob titles.
#
# Supported formats:
#   - Minecraft format code: §7, §6, §e, §a, §b, §c, §d, §f, §0..§9
#   - Digit/hex code:        7, 6, e, a, b, c, d, f
#   - Color name:            gray, gold, yellow, green, aqua, red, light_purple, white
#   - Disable color (plain): none, off, false
#
# Default: §7 (Light Gray / Muted)
pinyin_color = §7

# Phonetic Style:
# Options: marks (tone marks), numbers (tone numbers), plain (no tones),
#          bopomofo/zhuyin (注音符號), jyutping (粵拼)
# Default: marks
pinyin_style = marks

# Recall Mode:
# Set to true to show Pinyin first with Hanzi in secondary parentheses
# e.g., 'Zuànshí Jiàn §7(钻石剑)§r'
# Default: false
recall = false
